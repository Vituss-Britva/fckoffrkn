# Включить сжатие GZIP для улучшения производительности
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Кеширование в браузере для статических файлов
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Кеширование изображений на 1 месяц
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  
  # Кеширование CSS и JS на 2 недели
  ExpiresByType text/css "access plus 2 weeks"
  ExpiresByType application/javascript "access plus 2 weeks"
  ExpiresByType text/javascript "access plus 2 weeks"
  
  # Кеширование шрифтов на 1 месяц
  ExpiresByType font/ttf "access plus 1 month"
  ExpiresByType font/otf "access plus 1 month"
  ExpiresByType font/woff "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 month"
  
  # HTML не кешируется
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ETag для лучшего кеширования
<IfModule mod_headers.c>
  Header unset ETag
  FileETag none
</IfModule>

# Реврайт для красивых URL (если нужно)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /fckoffrkn/
  
  # Блокировка доступа к скрытым файлам
  RewriteRule "^\." - [F]
  
  # Редирект на HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Безопасность: отключить индексирование директорий
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Предотвращение доступа к чувствительным файлам
<FilesMatch "\.(env|yml|yaml|config|private|secret|key)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Правильные MIME типы
<IfModule mod_mime.c>
  AddType text/html .html
  AddType text/css .css
  AddType application/javascript .js
  AddType image/webp .webp
  AddType application/json .json
  AddCharset UTF-8 .html .css .js .json
</IfModule>

# Cache-Control заголовки для лучшего кеширования
<IfModule mod_headers.c>
  # Кеш для статических ресурсов
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|css|js|woff|woff2|ttf|otf|eot|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # Без кеша для HTML
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  
  # Безопасность
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
